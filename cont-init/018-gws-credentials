#!/bin/sh
# Write the GWS service account JSON (from Fly secret) to the volume
# so gws CLI can use it via GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE.
if [ -n "$GOOGLE_WORKSPACE_CLI_CREDENTIALS_JSON" ]; then
    mkdir -p /opt/data/.gws
    printf '%s' "$GOOGLE_WORKSPACE_CLI_CREDENTIALS_JSON" > /opt/data/.gws/service-account.json
    chown hermes:hermes /opt/data/.gws/service-account.json
    chmod 600 /opt/data/.gws/service-account.json
fi
