#!/bin/sh
# Ensure uv/uvx state dirs exist and are owned by hermes so `uvx <tool>`
# installs land on the volume and persist (UV_CACHE_DIR, UV_TOOL_DIR,
# UV_PYTHON_INSTALL_DIR all point under /opt/data/.uv).
mkdir -p /opt/data/.uv/cache /opt/data/.uv/tools /opt/data/.uv/python
chown -R hermes:hermes /opt/data/.uv 2>/dev/null || true